PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/talentscope
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# REDIS CONFIGURATION (Secondary caching layer - MongoDB is primary source of truth)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ts:
