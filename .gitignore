# --- Dependencies ---
node_modules/
**/node_modules/

# --- Environment & Secrets ---
.env
.env.*
!.env.example
backend/.env
backend/.env.local

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editors / IDEs ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Misc ---
*.tmp
*.bak
*.orig

# =============================================
# Backend (Node.js / Express)
# =============================================
backend/node_modules/
backend/dist/
backend/build/
backend/coverage/
backend/.nyc_output/
backend/npm-debug.log*

# =============================================
# Mobile (React Native / Expo)
# =============================================
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/build/
mobile/web-build/
mobile/.expo-export-test/
mobile/.expo-shared/
mobile/coverage/

# Expo web export output
mobile/expo-web/

# Metro / Babel / TypeScript caches
mobile/.metro/
mobile/.babel-cache/
mobile/*.tsbuildinfo

# iOS
mobile/ios/
mobile/*.ipa
mobile/*.dSYM.zip
mobile/*.dSYM

# Android
mobile/android/
mobile/*.apk
mobile/*.aab
mobile/captures/

# Native build generated folders
mobile/.gradle/
mobile/!.keystore

# Fastlane
mobile/fastlane/report.xml
mobile/fastlane/Preview.html
mobile/fastlane/screenshots/**/*.png
mobile/fastlane/test_output/

# Test temp scripts (local only)
mobile/repro*.cjs
mobile/repro*.js

# Expo environment overrides (optional local overrides)
mobile/.env.local

# =============================================
# Root-level test / diagnostic artifacts
# =============================================
repro.cjs
repro*.cjs
*.png
!mobile/src/**/*.png
